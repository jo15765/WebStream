{
  "name": "webstream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Xtream Codes IPTV player — React + Express",
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS='--max-http-header-size=65536' node --watch server/index.js",
    "build": "webpack --config webpack.config.cjs --mode production",
    "start": "NODE_ENV=production NODE_OPTIONS='--max-http-header-size=65536' node server/index.js",
    "lint": "oxlint src server"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "hls.js": "^1.6.2",
    "mpegts.js": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "oxlint": "^1.81.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2"
  }
}
